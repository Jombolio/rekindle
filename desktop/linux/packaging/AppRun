#!/bin/sh
# AppImage entry point. Resolves the mount point at runtime and hands off to the
# bundled binary, which finds its own libraries via the $ORIGIN/lib rpath set in
# linux/CMakeLists.txt — so nothing here depends on where the AppImage lives.
set -e
HERE=$(dirname "$(readlink -f "$0")")
exec "$HERE/usr/bin/rekindle" "$@"
