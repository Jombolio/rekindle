{
  "Rekindle": {
    "DataPath": "data",
    "CachePath": "data/cache",
    "CacheMaxSizeBytes": 10737418240,
    "UpdateSource": "https://git.jombo.uk/Jombo/rekindle",
    "UpdateFallbackSource": "https://github.com/Jombolio/rekindle"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Rekindle",
    "Audience": "Rekindle",
    "ExpiryDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080"
}
